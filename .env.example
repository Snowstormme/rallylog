# Local development can omit every value below and use SQLite.
# Production fails closed if its required values are missing.
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
# Use the limited rallylog_app role and require encrypted transport.
# DATABASE_URL=postgresql://rallylog_app:password@host/database?sslmode=require
# PUBLIC_HOST=rallylog.example.com
REGISTRATION_ENABLED=false
# RESEND_API_KEY=re_...
# MAIL_FROM=Rallylog <account@your-verified-domain.example>
# ADMIN_EMAIL=owner@example.com
# CONTACT_EMAIL=privacy@example.com
# Free current/upcoming ATP and WTA data from https://livetennisapi.com/
# LIVETENNISAPI_KEY=lt_...
